import "vector"
| include "test"

def assert_close(actual, expected):
  assert_true(abs(actual - expected) < 0.000000001)
end

def assert_vec_close(actual, expected):
  assert_eq(len(actual), len(expected))
  | let _ = foreach(p, zip(actual, expected)): assert_close(p[0], p[1]);
  | None
end

def fails(f): try: f() catch: "failed";

# =========================================================================
# arithmetic
# =========================================================================

def test_dot():
  assert_eq(vector::dot([1, 2, 3], [4, 5, 6]), 32)
  | assert_eq(vector::dot([1, 0], [0, 1]), 0)
  | assert_eq(vector::dot([2], [3]), 6)
end

def test_dot_of_empty_vectors():
  assert_eq(vector::dot([], []), 0)
end

def test_norm():
  assert_eq(vector::norm([3, 4]), 5)
  | assert_eq(vector::norm([0, 0]), 0)
  | assert_eq(vector::norm([-3, -4]), 5)
  | assert_eq(vector::norm([]), 0)
end

def test_add_and_sub():
  assert_eq(vector::add([1, 2], [3, 4]), [4, 6])
  | assert_eq(vector::sub([5, 5], [1, 2]), [4, 3])
  | assert_eq(vector::add([], []), [])
end

def test_scale():
  assert_eq(vector::scale([1, 2, 3], 2), [2, 4, 6])
  | assert_eq(vector::scale([1, 2], 0), [0, 0])
  | assert_eq(vector::scale([1, 2], -1), [-1, -2])
end

def test_normalize_gives_unit_length():
  let v = vector::normalize([3, 4])
  | assert_vec_close(v, [0.6, 0.8])
  | assert_close(vector::norm(v), 1)
end

def test_normalize_keeps_the_zero_vector():
  assert_eq(vector::normalize([0, 0]), [0, 0])
end

def test_euclidean():
  assert_eq(vector::euclidean([0, 0], [3, 4]), 5)
  | assert_eq(vector::euclidean([1, 1], [1, 1]), 0)
  | assert_eq(vector::euclidean([5], [2]), 3)
end

def test_mean():
  assert_eq(vector::mean([[1, 2], [3, 4]]), [2, 3])
  | assert_eq(vector::mean([[1, 2, 3]]), [1, 2, 3])
  | assert_eq(vector::mean([[0, 0], [0, 6], [6, 0]]), [2, 2])
end

# =========================================================================
# similarity
# =========================================================================

def test_cosine_of_parallel_orthogonal_and_opposite_vectors():
  assert_close(vector::cosine([1, 2], [2, 4]), 1)
  | assert_close(vector::cosine([1, 0], [0, 1]), 0)
  | assert_close(vector::cosine([1, 2], [-1, -2]), -1)
end

def test_cosine_ignores_length():
  assert_close(vector::cosine([1, 1], [100, 100]), 1)
end

def test_cosine_with_a_zero_vector_is_zero():
  assert_eq(vector::cosine([0, 0], [1, 2]), 0)
  | assert_eq(vector::cosine([1, 2], [0, 0]), 0)
  | assert_eq(vector::cosine([0, 0], [0, 0]), 0)
end

def test_cosine_is_symmetric():
  assert_close(vector::cosine([1, 2, 3], [3, 1, 2]), vector::cosine([3, 1, 2], [1, 2, 3]))
end

# =========================================================================
# errors
# =========================================================================

def test_length_mismatch_is_rejected():
  assert_eq(fails(fn(): vector::dot([1, 2], [1]);), "failed")
  | assert_eq(fails(fn(): vector::add([1], [1, 2]);), "failed")
  | assert_eq(fails(fn(): vector::sub([1], [1, 2]);), "failed")
  | assert_eq(fails(fn(): vector::euclidean([1], [1, 2]);), "failed")
end

def test_mean_of_no_vectors_is_rejected():
  assert_eq(fails(fn(): vector::mean([]);), "failed")
end

# =========================================================================
# nearest neighbours
# =========================================================================

def sample_vectors():
  [[0, 1], [1, 0.1], [1, 1], [-1, 0]]
end

def test_nearest_orders_by_similarity():
  let r = vector::nearest([1, 0], sample_vectors(), 3)
  | assert_eq(map(r, fn(p): p[1];), [1, 2, 0])
end

def test_nearest_scores_are_cosine_similarities():
  let r = vector::nearest([1, 0], sample_vectors(), 2)
  | assert_close(r[0][0], vector::cosine([1, 0], [1, 0.1]))
  | assert_close(r[1][0], vector::cosine([1, 0], [1, 1]))
end

def test_nearest_returns_the_opposite_vector_last():
  let r = vector::nearest([1, 0], sample_vectors(), 4)
  | assert_eq(r[3][1], 3)
end

def test_nearest_with_k_beyond_the_number_of_vectors():
  assert_eq(len(vector::nearest([1, 0], sample_vectors(), 10)), 4)
end

def test_nearest_with_k_of_one():
  let r = vector::nearest([0, 1], sample_vectors(), 1)
  | assert_eq(len(r), 1)
  | assert_eq(r[0][1], 0)
end

def test_nearest_with_nothing_to_search():
  assert_eq(vector::nearest([1, 0], [], 3), [])
  | assert_eq(vector::nearest([1, 0], sample_vectors(), 0), [])
  | assert_eq(vector::nearest([1, 0], sample_vectors(), -2), [])
end

def test_nearest_ties_prefer_the_larger_index():
  let r = vector::nearest([1, 0], [[1, 0], [2, 0], [3, 0]], 3)
  | assert_eq(map(r, fn(p): p[1];), [2, 1, 0])
end

def test_nearest_does_not_depend_on_query_length():
  let a = vector::nearest([1, 0], sample_vectors(), 4)
  | let b = vector::nearest([50, 0], sample_vectors(), 4)
  | assert_eq(map(a, fn(p): p[1];), map(b, fn(p): p[1];))
end

def test_nearest_by_distance_orders_by_closeness():
  let r = vector::nearest_by_distance([1, 0], sample_vectors(), 3)
  | assert_eq(map(r, fn(p): p[1];), [1, 2, 0])
end

def test_nearest_by_distance_reports_distances():
  let r = vector::nearest_by_distance([0, 0], [[3, 4], [1, 0]], 2)
  | assert_eq(r, [[1, 1], [5, 0]])
end

def test_nearest_by_distance_ties_prefer_the_smaller_index():
  let r = vector::nearest_by_distance([0, 0], [[1, 0], [0, 1], [-1, 0]], 3)
  | assert_eq(map(r, fn(p): p[1];), [0, 1, 2])
end

def test_nearest_by_distance_with_nothing_to_search():
  assert_eq(vector::nearest_by_distance([1, 0], [], 3), [])
  | assert_eq(vector::nearest_by_distance([1, 0], sample_vectors(), 0), [])
end

def test_nearest_and_nearest_by_distance_agree_on_unit_vectors():
  let unit = map(sample_vectors(), fn(v): vector::normalize(v);)
  | let q = vector::normalize([1, 0.2])
  | let by_cosine = map(vector::nearest(q, unit, 4), fn(p): p[1];)
  | let by_distance = map(vector::nearest_by_distance(q, unit, 4), fn(p): p[1];)
  | assert_eq(by_cosine, by_distance)
end
